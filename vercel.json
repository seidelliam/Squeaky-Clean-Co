{
  "cleanUrls": true,
  "rewrites": [
    { "source": "/", "destination": "/site" },
    { "source": "/vendor", "destination": "/site/vendor" },
    { "source": "/vendor/", "destination": "/site/vendor" },
    { "source": "/internal", "destination": "/site/internal" },
    { "source": "/internal/", "destination": "/site/internal" }
  ]
}
